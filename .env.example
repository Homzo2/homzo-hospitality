# Homzo Backend Environment Configuration Template
PORT=3000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# Database Configuration
DATABASE_DIALECT=sqlite
DATABASE_STORAGE=database.sqlite

# Payments Configuration (Optional - simulation mode is active if empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
UPI_ID=your_upi_id@bank

# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=Homzo <otp@homzo.co.in>

# WhatsApp Service (Meta Cloud API / Twilio)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# SMS Service (Fast2SMS / Twilio)
FAST2SMS_API_KEY=
TWILIO_PHONE_NUMBER=
